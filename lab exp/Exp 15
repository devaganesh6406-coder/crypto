 char s[5000];printf("Enter ciphertext:\n");if(!fgets(s,sizeof s,stdin))return 1;
 for(int k=0;k<26;k++){printf("Shift %2d: ",k);
  for(int i=0;s[i];i++)if(isalpha((unsigned char)s[i]))putchar('a'+(tolower((unsigned char)s[i])-'a'-k+26)%26);else putchar(s[i]);
 }
