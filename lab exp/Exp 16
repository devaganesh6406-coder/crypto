#include <stdio.h>
#include <ctype.h>
#include <string.h>
int main(void){
 char s[10000],out[10000];int f[26]={0},order[26],n;
 char english[]="ETAOINSHRDLCUMWFGYPBVKJXQZ";
 printf("Enter ciphertext using letters A-Z:\n");if(!fgets(s,sizeof s,stdin))return 1;
 for(int i=0;s[i];i++)if(isalpha((unsigned char)s[i]))f[toupper((unsigned char)s[i])-'A']++;
 for(int i=0;i<26;i++)order[i]=i;
 for(int i=0;i<26;i++)for(int j=i+1;j<26;j++)if(f[order[j]]>f[order[i]]){int t=order[i];order[i]=order[j];order[j]=t;}
 char map[26];for(int i=0;i<26;i++)map[order[i]]=english[i];
 n=(int)strlen(s);
 for(int i=0;i<n;i++)if(isalpha((unsigned char)s[i])){char c=map[toupper((unsigned char)s[i])-'A'];out[i]=islower((unsigned char)s[i])?(char)tolower(c):c;}else out[i]=s[i];
 out[n]='\0';printf("Best simple frequency guess:\n%s",out);
 return 0;
}
