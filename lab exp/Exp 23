void perm(int*a,int*b,int*p,int n){for(int i=0;i<n;i++)b[i]=a[p[i]-1];}
void keys(int*k,int*k1,int*k2){int x[10],l[5],r[5],y[10];perm(k,x,P10,10);for(int i=0;i<5;i++){l[i]=x[(i+1)%5];r[i]=x[5+(i+1)%5];}for(int i=0;i<5;i++){y[i]=l[i];y[i+5]=r[i];}perm(y,k1,P8,8);for(int i=0;i<5;i++){y[i]=l[(i+2)%5];y[i+5]=r[(i+2)%5];}perm(y,k2,P8,8);}
void fk(int*b,int*k){int l[4],r[4],e[8],x[8],z[4],p[4];for(int i=0;i<4;i++){l[i]=b[i];r[i]=b[i+4];}perm(r,e,EP,8);for(int i=0;i<8;i++)x[i]=e[i]^k[i];int row=x[0]*2+x[3],col=x[1]*2+x[2],v=S0[row][col];z[0]=v/2;z[1]=v%2;row=x[4]*2+x[7];col=x[5]*2+x[6];v=S1[row][col];z[2]=v/2;z[3]=v%2;perm(z,p,P4,4);for(int i=0;i<4;i++){b[i]=l[i]^p[i];b[i+4]=r[i];}}
void sdes(int*in,int*k1,int*k2,int*out){int b[8],t;perm(in,b,IP,8);fk(b,k1);for(int i=0;i<4;i++){t=b[i];b[i]=b[i+4];b[i+4]=t;}fk(b,k2);perm(b,out,IP1,8);}
