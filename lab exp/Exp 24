
#include <stdio.h>

int gcd(int a, int b)
{
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    int n = 3599, e = 31;
    int p = 0, q = 0, phi, d;

    for (int i = 2; i <= n / i; i++) {
        if (n % i == 0) {
            p = i;
            q = n / i;
            break;
        }
    }

    phi = (p - 1) * (q - 1);

    for (d = 1; d < phi; d++) {
        if ((e * d) % phi == 1)
            break;
    }

    printf("p = %d\n", p);
    printf("q = %d\n", q);
    printf("Phi(n) = %d\n", phi);
    printf("Public Key = (%d, %d)\n", e, n);
    printf("Private Key = (%d, %d)\n", d, n);

    return 0;
}
