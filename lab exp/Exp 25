
#include <stdio.h>

int gcd(int a, int b)
{
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    int n, m, g;

    printf("Enter RSA modulus n: ");
    scanf("%d", &n);

    printf("Enter plaintext block m: ");
    scanf("%d", &m);

    g = gcd(n, m);

    printf("GCD = %d\n", g);

    if (g > 1 && g < n) {
        printf("Factor found: %d\n", g);
        printf("Other factor: %d\n", n / g);
        printf("RSA modulus is compromised!\n");
    }
    else if (g == n) {
        printf("Plaintext is divisible by n; no useful factor found.\n");
    }
    else {
        printf("No common factor found.\n");
    }

    return 0;
}
