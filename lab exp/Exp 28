
#include <stdio.h>

long long power(long long a, long long b, long long q)
{
    long long r = 1;

    while (b > 0) {
        if (b % 2)
            r = (r * a) % q;

        a = (a * a) % q;
        b /= 2;
    }

    return r;
}

int main()
{
    long long q = 23, a = 5;
    long long x = 6, y = 15;

    long long A = power(a, x, q);
    long long B = power(a, y, q);

    long long keyA = power(B, x, q);
    long long keyB = power(A, y, q);

    printf("Alice sends: %lld\n", A);
    printf("Bob sends: %lld\n", B);

    printf("Alice shared key: %lld\n", keyA);
    printf("Bob shared key: %lld\n", keyB);

    return 0;
}
