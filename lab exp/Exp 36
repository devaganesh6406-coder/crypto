
#include <stdio.h>

int gcd(int a, int b)
{
    while (b) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char text[100];
    int a, b;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter a and b: ");
    scanf("%d %d", &a, &b);

    if (gcd(a, 26) != 1) {
        printf("Invalid a value! Encryption is not reversible.\n");
        return 1;
    }

    printf("Ciphertext: ");

    for (int i = 0; text[i]; i++) {
        int p = text[i] - 'A';
        int c = (a * p + b) % 26;
        printf("%c", c + 'A');
    }

    printf("\n");

    return 0;
}
