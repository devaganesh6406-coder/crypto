
#include <stdio.h>

int main()
{
    int p[2][2], c[2][2];
    int det, inv = -1;
    int key[2][2];

    printf("Enter plaintext matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &p[i][j]);

    printf("Enter ciphertext matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &c[i][j]);

    det = (p[0][0] * p[1][1] -
           p[0][1] * p[1][0]) % 26;

    if (det < 0) det += 26;

    for (int i = 1; i < 26; i++)
        if ((det * i) % 26 == 1)
            inv = i;

    if (inv == -1) {
        printf("Plaintext matrix is not invertible.\n");
        return 1;
    }

    int pinv[2][2];

    pinv[0][0] = (p[1][1] * inv) % 26;
    pinv[0][1] = (-p[0][1] * inv % 26 + 26) % 26;
    pinv[1][0] = (-p[1][0] * inv % 26 + 26) % 26;
    pinv[1][1] = (p[0][0] * inv) % 26;

    printf("\nRecovered Key Matrix:\n");

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            key[i][j] = 0;

            for (int k = 0; k < 2; k++)
                key[i][j] += c[i][k] * pinv[k][j];

            key[i][j] %= 26;
            printf("%d ", key[i][j]);
        }
        printf("\n");
    }

    return 0;
}
