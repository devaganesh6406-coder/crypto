#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0)
    {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main()
{
    char cipher[1000];
    int a, b, i, p;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("\nPossible decrypted texts:\n");

    for (a = 1; a < 26; a++)
    {
        if (gcd(a, 26) == 1)
        {
            for (b = 0; b < 26; b++)
            {
                int inv = 0;

                for (i = 1; i < 26; i++)
                    if ((a * i) % 26 == 1)
                        inv = i;

                printf("\na=%d, b=%d: ", a, b);

                for (i = 0; cipher[i] != '\0'; i++)
                {
                    if (isalpha(cipher[i]))
                    {
                        int c = toupper(cipher[i]) - 'A';
                        p = (inv * (c - b + 26)) % 26;
                        printf("%c", p + 'A');
                    }
                    else
                        printf("%c", cipher[i]);
                }
            }
        }
    }

    return 0;
}
