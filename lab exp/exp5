#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100];
    int a, b, i, p, c;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter value of a: ");
    scanf("%d", &a);

    printf("Enter value of b: ");
    scanf("%d", &b);

    if (a < 0 || a >= 26 || b < 0 || b >= 26)
    {
        printf("Invalid key values!");
        return 0;
    }

    int gcd = 0;
    for (i = 1; i <= 26; i++)
        if (a % i == 0 && 26 % i == 0)
            gcd = i;

    if (gcd != 1)
    {
        printf("Invalid key! gcd(a, 26) must be 1.");
        return 0;
    }

    printf("Encrypted text: ");

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha(text[i]))
        {
            p = toupper(text[i]) - 'A';
            c = (a * p + b) % 26;
            printf("%c", c + 'A');
        }
        else
            printf("%c", text[i]);
    }

    return 0;
}
