#include <stdio.h>
#include <string.h>
#include <ctype.h>
int main(void) {
    char cipher[10000], key[27], out[10000];
    printf("Enter ciphertext using A-Z (map each symbol consistently first):\n");
    if (!fgets(cipher, sizeof cipher, stdin)) return 1;
    printf("Enter 26-letter decryption key for cipher A-Z (? = unknown):\n");
    if (!fgets(key, sizeof key, stdin)) return 1;
    for (int i=0; i<26; i++) key[i] = (char)tolower((unsigned char)key[i]);
    for (int i=0; cipher[i]; i++) {
        if (isalpha((unsigned char)cipher[i])) {
            int k = toupper((unsigned char)cipher[i])-'A';
            out[i] = (key[k] >= 'a' && key[k] <= 'z') ? key[k] : '_';
        } else out[i] = cipher[i];
    }
    out[strlen(cipher)] = '\0';
    printf("Partial plaintext:\n%s", out);
    return 0;
}
